# 复制为 deploy/.env 并 chmod 600。不要提交真实值。

# ---- 镜像与目录(docker compose 变量)----
IPGUARD_IMAGE=ghcr.io/duskedge/ipguard:latest
IPGUARD_PORT=28090
IPGUARD_DATA_DIR=./data
PROXY_LOGS_DIR=/path/to/proxy/logs         # 反向代理访问日志目录(combined 格式)
PROXY_NGINX_DIR=/path/to/npm/data/nginx    # 可选:NPM 的 data/nginx 目录;没有就指向一个空目录
CROWDSEC_NETWORK=crowdsec_default          # CrowdSec 所在的 docker 网络
# IPGUARD_CROWDSEC_URL=http://192.168.1.10:8080   # CrowdSec 在别的机器时改这里,并去掉 compose 里的 crowdsec 网络

# ---- 登录(二选一;推荐 hash:docker run --rm ghcr.io/duskedge/ipguard hash-password '<口令>')----
IPGUARD_AUTH_USERNAME=admin
IPGUARD_AUTH_PASSWORD=
# IPGUARD_AUTH_PASSWORDHASH=

# ---- CrowdSec machine 凭据(ipguard 通过 LAPI 增删封禁决策)----
# 在 CrowdSec 所在机器执行:
#   docker exec crowdsec cscli machines add ipguard --password '<口令>' -f /dev/null
IPGUARD_CROWDSEC_MACHINEID=ipguard
IPGUARD_CROWDSEC_PASSWORD=

# ---- 展示 ----
TZ=Asia/Shanghai
IPGUARD_SERVER_SITE=example.com            # 侧栏副标题,仅展示用
# IPGUARD_LOGS_BACKENDALIASES=192.168.1.250=HOST   # 把后端地址显示成好记的名字
# 日志里图片预览链接的对外协议/端口(只生成链接,不改变 Nginx 监听)
IPGUARD_LOGS_PREVIEWSCHEME=https
IPGUARD_LOGS_PREVIEWPORT=443
