# 复制为 overlay/ipguard.env(chmod 600,勿提交)。给 --with-ipguard 用。

# 镜像(默认指向作者私有 registry;换成你能拉到的镜像或自行 build)
# IPGUARD_IMAGE=registry.example.com/ipguard:latest

# 登录(推荐用 hash:docker run --rm <镜像> hash-password '<口令>')
IPGUARD_AUTH_USERNAME=admin
IPGUARD_AUTH_PASSWORD=
# IPGUARD_AUTH_PASSWORDHASH=

# CrowdSec machine 凭据(setup.sh --with-ipguard 会自动 cscli machines add 并填这里)
IPGUARD_CROWDSEC_MACHINEID=ipguard
IPGUARD_CROWDSEC_PASSWORD=

# 侧栏副标题 / 图片预览对外协议端口
IPGUARD_SERVER_SITE=example.com
IPGUARD_LOGS_PREVIEWSCHEME=https
IPGUARD_LOGS_PREVIEWPORT=4443
