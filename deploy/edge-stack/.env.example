# ============ 边缘防护一键搭建 · 宿主相关参数 ============
# 复制为 .env 后按本机网络修改。带 ★ 的是必须确认的项。
# cp .env.example .env && vi .env && ./setup.sh

# ---- 通用 ----
TZ=Asia/Shanghai

# ---- CrowdSec ----
LAPI_PORT=8099                      # LAPI 宿主映射端口(给 ipguard / 调试用)
ADDRESS_LIST=crowdsec               # ROS 封禁地址表名(bouncer 写它、ROS drop 规则引用它)
# 关掉 CAPI 社区黑名单在线拉取。独立/验证部署设 true:避免上万条社区黑名单灌进 ROS,
# 只靠本地检测 + `cscli decisions add` 手动决策验证链路。默认 false = 正常拉社区黑名单。
CROWDSEC_DISABLE_CAPI=false

# ---- NPM 数据库:sqlite | mysql-internal | mysql-external ----
NPM_DB_MODE=sqlite                  # 默认 SQLite(免外部库);要 MySQL 改这里
# 下面这些仅 mysql-internal / mysql-external 用:
DB_MYSQL_HOST=                      # 仅 external:本宿主上的库填 SHIM_IP;别的机器填其 LAN IP
DB_MYSQL_PORT=3306
DB_MYSQL_NAME=npm
DB_MYSQL_USER=npm
DB_MYSQL_PASSWORD=change-me-db
DB_MYSQL_ROOT_PASSWORD=change-me-root   # 仅 mysql-internal(建库 root 口令)

# ---- macvlan:反代拿真实客户端 IP 的关键,按目标机网络改 ★ ----
PARENT_IFACE=eth0                   # ★ 宿主 LAN 网卡名(`ip -br link` 查;开了 Open vSwitch 的 NAS 常是 ovs_eth1)
LAN_SUBNET=192.168.1.0/24          # ★ LAN 网段
LAN_GATEWAY=192.168.1.1            # ★ LAN 网关(通常就是路由器)
NPM_IP=192.168.1.45                # ★ 分给 npm-guard 的独立 LAN IP(必须空闲、不在 DHCP 池)
SHIM_IP=192.168.1.250              # ★ shim 用的 LAN IP(必须空闲;宿主↔npm-guard 走它)

# ---- RouterOS:封禁落地 ★ ----
MIKROTIK_HOST=192.168.1.1:8728     # ★ ROS API 地址(默认 8728 非 TLS)
MIKROTIK_USER=crowdsec              # ROS 专用 API 账号(setup.sh 可自动建)
MIKROTIK_PASS=change-me-strong      # ★ 该账号密码
MIKROTIK_WAN_IFACE=pppoe-wan        # ★ WAN 接口名(raw 丢弃规则只作用于此口)

# ---- 路由器公网端口转发(dstnat → NPM_IP:443)----
# 填了且设了 ROS_SSH,setup.sh 自动在 ROS 加 dstnat;留空=不自动加。
PUBLIC_PORT=4444                    # 对外端口(公网访问走它 → 转到 NPM 的 443)

# ---- NPM 自动初始化(改默认账号 admin@example.com/changeme)----
NPM_ADMIN_EMAIL=you@example.com     # 新管理员邮箱(= 登录名)
NPM_ADMIN_PASSWORD=                 # 新密码(留空=不自动改,手动登录改)
NPM_ADMIN_NAME=Administrator

# ---- Cloudflare 证书(自动申请,需 python3)----
CERT_DOMAINS=                       # 如 "*.example.com,example.com" 或单域名 "example.com"(留空=不自动申请)
CF_DNS_API_TOKEN=                   # Cloudflare Token,权限 Zone:DNS:Edit
LETSENCRYPT_EMAIL=                  # LE 注册邮箱(留空自动按域名推断)

# ---- 自动创建一个 Proxy Host(反代)----
# 填了 PROXY_DOMAIN,setup.sh 会在 NPM 里自动建这个域名的反代,并绑上面申请到的证书、强制 SSL。
PROXY_DOMAIN=                       # 如 npm.example.com(配合 CERT_DOMAINS=*.example.com 泛域名证书;留空=不自动建反代)
PROXY_FORWARD_HOST=127.0.0.1        # 后端地址(127.0.0.1=npm-guard 容器自身)
PROXY_FORWARD_PORT=81               # 后端端口(81=NPM 自己的管理后台)
PROXY_FORWARD_SCHEME=http           # 后端协议 http|https

# ---- ipguard 面板(--with-ipguard 用)----
# 镜像必须写在主 .env(compose 只从这里取变量)。默认用公开镜像,无需登录;
# 换成自建/私有镜像时填 REGISTRY_*,setup.sh 会先 docker login。
IPGUARD_IMAGE=ghcr.io/duskedge/ipguard:latest
REGISTRY_HOST=ghcr.io
REGISTRY_USER=                      # 镜像仓库用户名(公开镜像留空)
REGISTRY_TOKEN=                     # 镜像仓库令牌(GHCR 需 read:packages;留空=匿名拉取)

# ---- AdGuard Home(--with-adguard 用;走宿主端口,不占 LAN IP)----
ADGUARD_DNS_PORT=53                 # DNS 宿主端口(需空闲)
ADGUARD_WEB_PORT=3000               # 后台宿主端口
ADGUARD_USERNAME=admin              # 管理员用户名
ADGUARD_PASSWORD=                   # 管理员密码(留空=不自动初始化,需手动走向导)
ADGUARD_UPSTREAM=https://dns.alidns.com/dns-query   # 上游 DNS

# ---- RouterOS 操作走 REST API(ROS 的 www 服务),不用 SSH / 不用 key ----
# 受限账号 MIKROTIK_USER 不存在时,setup.sh 用 admin 建一次:
#   ROS_ADMIN_PASS 留空 = 运行时交互提示输入(推荐,不落盘);填了 = 非交互直接用。
# 之后加删 dstnat、bouncer 写地址表都只用受限账号。
ROS_ADMIN_USER=admin
ROS_ADMIN_PASS=
# ROS_REST_URL=http://192.168.1.1  # 默认取 MIKROTIK_HOST 的主机部分

# ---- 可选:Cloudflare DNS 挑战证书的 pip 镜像(国内解锁 certbot-dns-cloudflare 安装)----
# 国内取消注释换成阿里云;海外保持默认即可。证书本身在 NPM 界面里用 CF Token 申请(见 README)。
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com

# ---- 由 setup.sh 自动填写,勿手填 ----
BOUNCER_API_KEY=
